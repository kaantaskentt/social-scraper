# Copy with npm run setup. Keep real keys in .env only (it is gitignored).

# Scan: collect reels, transcribe, label
APIFY_TOKEN=
TYPESAFE_API_KEY=
# Transcripts: choose groq OR fireworks, then fill that provider's key
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
FIREWORKS_API_KEY=

# Why do these win?, Look and Copy: watching videos, pictures, Veo 3.1 and Gemini Omni video
GEMINI_API_KEY=

# Optional: Claude as a second opinion on finished reels
ANTHROPIC_API_KEY=

PORT=5190

# Local pacing ceilings. Lower these to fit your actual account limits.
FIREWORKS_REQUESTS_PER_MINUTE=60
GROQ_REQUESTS_PER_MINUTE=20
